name: "bert_ensemble"
platform: "ensemble"
max_batch_size: 0
input [
  {
    name: "text"
    data_type: TYPE_STRING
    dims: [-1, 1]
  }
]
output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [-1, 768]
  }
]
ensemble_scheduling {
  step [
    {
      model_name: "bert_tokenizer"
      model_version: -1
      input_map {
        key: "text"
        value: "text"
      }
      output_map {
        key: "token_ids"
        value: "token_ids"
      }
      output_map {
        key: "attn_mask"
        value: "attn_mask"
      }
    },
    {
      model_name: "bert"
      model_version: -1
      input_map {
        key: "token_ids"
        value: "token_ids"
      }
      input_map {
        key: "attn_mask"
        value: "attn_mask"
      }
      output_map {
        key: "output"
        value: "output"
      }
    }
  ]
}
