name: "similarity_ensemble"
platform: "ensemble"
max_batch_size: 0

input [
  {
    name: "text"
    data_type: TYPE_STRING
    dims: [-1, 1]
  }
]

output [
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [-1]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "bert_tokenizer"
      model_version: -1
      input_map  { key: "text"       value: "text"       }
      output_map { key: "token_ids"  value: "token_ids"  }
      output_map { key: "attn_mask"  value: "attn_mask"  }
    },
    {
      model_name: "bert"
      model_version: -1
      input_map  { key: "token_ids"  value: "token_ids"  }
      input_map  { key: "attn_mask"  value: "attn_mask"  }
      output_map { key: "output"     value: "embeddings" }
    },
    {
      model_name: "cosine_similarity"
      model_version: -1
      input_map  { key: "embeddings" value: "embeddings" }
      output_map { key: "scores"     value: "scores"     }
    }
  ]
}
