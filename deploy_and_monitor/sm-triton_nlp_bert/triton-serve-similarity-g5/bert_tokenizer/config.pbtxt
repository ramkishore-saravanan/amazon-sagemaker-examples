name: "bert_tokenizer"
backend: "python"
max_batch_size: 0
input [
  {
    name: "text"
    data_type: TYPE_STRING
    dims: [-1, 1]
  }
]
output [
  {
    name: "token_ids"
    data_type: TYPE_INT32
    dims: [-1, 128]
  },
  {
    name: "attn_mask"
    data_type: TYPE_INT32
    dims: [-1, 128]
  }
]
